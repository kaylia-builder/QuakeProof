# Receiver address only. Never put a private key or seed phrase here.
PAY_TO=0x0000000000000000000000000000000000000000
PRICE_USD=0.01
PORT=8080

# Defaults target Base Sepolia USDC. Override all asset fields together when
# using another EVM network or token.
X402_NETWORK=eip155:84532
X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
X402_EIP712_NAME=USDC
X402_EIP712_VERSION=2
FACILITATOR_URL=https://x402.org/facilitator
UPSTREAM_URL=https://earthquake.usgs.gov/fdsnws/event/1/
UPSTREAM_TIMEOUT_MS=8000
SERVICE_DESCRIPTION=Agent-ready earthquake intelligence from the USGS catalog

# Paid smoke-test client only. Use a dedicated Base Sepolia wallet and never
# commit its private key. The client refuses every network except eip155:84532.
TESTNET_PAYER_PRIVATE_KEY=
QUAKEPROOF_BASE_URL=https://your-quakeproof-deployment.example

# Read-only facilitator diagnostics. The generated JSON contains no signing
# material and is ignored by git by default.
DIAGNOSTIC_OUT=facilitator-diagnostic.json
