{
  "name": "quakeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verifiable earthquake intelligence for autonomous agents",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "build:contracts": "forge build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run validate:manifest && npm run test:contracts",
    "diagnose:facilitator": "tsx scripts/diagnose-facilitator.ts",
    "testnet:paid-smoke": "tsx scripts/testnet-paid-smoke.ts",
    "test:contracts": "forge test",
    "chainlink:deploy": "tsx scripts/deploy-chainlink-consumer.ts",
    "chainlink:request": "tsx scripts/request-chainlink-verification.ts",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fetch": "^2.26.0",
    "express": "^5.1.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "yaml": "^2.8.1"
  }
}
